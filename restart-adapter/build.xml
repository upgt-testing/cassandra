<?xml version="1.0" encoding="UTF-8"?>
<project name="cassandra-restart-adapter" default="jar" basedir=".">

    <description>
        Cassandra Restart Testing Adapter - Build with Ant and Java 17
    </description>

    <!-- Properties -->
    <property name="version" value="5.0.6-SNAPSHOT"/>
    <property name="java.target.version" value="17"/>
    <property name="java.source.version" value="17"/>

    <!-- Directories -->
    <property name="src.dir" location="src/main/java"/>
    <property name="test.dir" location="src/test/java"/>
    <property name="resources.dir" location="src/main/resources"/>
    <property name="build.dir" location="build"/>
    <property name="build.classes" location="${build.dir}/classes"/>
    <property name="build.test.classes" location="${build.dir}/test-classes"/>
    <property name="dist.dir" location="dist"/>
    <property name="lib.dir" location="lib"/>

    <!-- External dependencies -->
    <property name="cassandra.home" location="../"/>
    <property name="restart.framework.dir" location="/home/shuai/xlab/restart_testing/RestartTestingFramework"/>

    <!-- Java 17 configuration -->
    <property name="java17.home" value="/usr/lib/jvm/java-17-openjdk-amd64"/>
    <property name="java.home" value="${java17.home}"/>

    <!-- Classpath for compilation -->
    <path id="compile.classpath">
        <!-- Restart Testing Framework Core -->
        <fileset dir="${restart.framework.dir}/restart-core/target" erroronmissingdir="false">
            <include name="restart-core-*.jar"/>
        </fileset>

        <!-- Cassandra distributed test API (dtest-api JAR) -->
        <fileset dir="${cassandra.home}/build/test/lib/jars" erroronmissingdir="false">
            <include name="dtest-api-*.jar"/>
        </fileset>

        <!-- Cassandra distributed test classes -->
        <pathelement location="${cassandra.home}/build/classes/main"/>
        <pathelement location="${cassandra.home}/build/test/classes"/>

        <!-- Cassandra libraries -->
        <fileset dir="${cassandra.home}/build/lib/jars" erroronmissingdir="false">
            <include name="**/*.jar"/>
        </fileset>
        <fileset dir="${cassandra.home}/build/test/lib/jars" erroronmissingdir="false">
            <include name="**/*.jar"/>
        </fileset>
        <fileset dir="${cassandra.home}/lib" erroronmissingdir="false">
            <include name="**/*.jar"/>
        </fileset>

        <!-- SLF4J -->
        <fileset dir="${lib.dir}" erroronmissingdir="false">
            <include name="slf4j-*.jar"/>
        </fileset>
    </path>

    <!-- Classpath for testing -->
    <path id="test.classpath">
        <path refid="compile.classpath"/>
        <pathelement location="${build.classes}"/>
        <pathelement location="${build.test.classes}"/>

        <!-- JUnit -->
        <fileset dir="${lib.dir}" erroronmissingdir="false">
            <include name="junit-*.jar"/>
            <include name="hamcrest-*.jar"/>
        </fileset>
        <fileset dir="${cassandra.home}/build/lib/jars" erroronmissingdir="false">
            <include name="junit-*.jar"/>
            <include name="hamcrest-*.jar"/>
        </fileset>
    </path>

    <!-- Targets -->

    <target name="init" description="Initialize build directories">
        <echo message="Building Cassandra Restart Adapter with Java ${java.source.version}"/>
        <echo message="Java Home: ${java17.home}"/>

        <mkdir dir="${build.dir}"/>
        <mkdir dir="${build.classes}"/>
        <mkdir dir="${build.test.classes}"/>
        <mkdir dir="${dist.dir}"/>
        <mkdir dir="${lib.dir}"/>

        <!-- Check Java version -->
        <exec executable="${java17.home}/bin/java" outputproperty="java.version.output">
            <arg value="-version"/>
        </exec>
        <echo message="Java version: ${java.version.output}"/>
    </target>

    <target name="download-deps" depends="init" description="Download dependencies if not present">
        <!-- Download SLF4J if not present -->
        <get src="https://repo1.maven.org/maven2/org/slf4j/slf4j-api/1.7.36/slf4j-api-1.7.36.jar"
             dest="${lib.dir}/slf4j-api-1.7.36.jar"
             skipexisting="true"
             verbose="true"
             usetimestamp="true"/>

        <!-- Download JUnit if not present -->
        <get src="https://repo1.maven.org/maven2/junit/junit/4.13.2/junit-4.13.2.jar"
             dest="${lib.dir}/junit-4.13.2.jar"
             skipexisting="true"
             verbose="true"
             usetimestamp="true"/>

        <get src="https://repo1.maven.org/maven2/org/hamcrest/hamcrest-core/1.3/hamcrest-core-1.3.jar"
             dest="${lib.dir}/hamcrest-core-1.3.jar"
             skipexisting="true"
             verbose="true"
             usetimestamp="true"/>
    </target>

    <target name="compile" depends="download-deps" description="Compile main source files">
        <echo message="Compiling with Java 17..."/>
        <javac srcdir="${src.dir}"
               destdir="${build.classes}"
               source="${java.source.version}"
               target="${java.target.version}"
               debug="true"
               includeantruntime="false"
               fork="true"
               executable="${java17.home}/bin/javac">
            <classpath refid="compile.classpath"/>
            <compilerarg value="-Xlint:unchecked"/>
        </javac>

        <!-- Copy resources -->
        <copy todir="${build.classes}">
            <fileset dir="${resources.dir}">
                <include name="**/*"/>
            </fileset>
        </copy>
    </target>

    <target name="compile-tests" depends="compile" description="Compile test source files">
        <echo message="Compiling tests with Java 17..."/>
        <javac srcdir="${test.dir}"
               destdir="${build.test.classes}"
               source="${java.source.version}"
               target="${java.target.version}"
               debug="true"
               includeantruntime="false"
               fork="true"
               executable="${java17.home}/bin/javac">
            <classpath refid="test.classpath"/>
            <compilerarg value="-Xlint:unchecked"/>
        </javac>
    </target>

    <target name="jar" depends="compile" description="Create JAR file">
        <jar destfile="${dist.dir}/cassandra-restart-adapter-${version}.jar"
             basedir="${build.classes}">
            <manifest>
                <attribute name="Implementation-Title" value="Cassandra Restart Testing Adapter"/>
                <attribute name="Implementation-Version" value="${version}"/>
                <attribute name="Implementation-Vendor" value="Apache Cassandra"/>
                <attribute name="Built-By" value="${user.name}"/>
                <attribute name="Build-Jdk" value="${java.source.version}"/>
            </manifest>
        </jar>
        <echo message="Created ${dist.dir}/cassandra-restart-adapter-${version}.jar"/>
    </target>

    <target name="test" depends="compile-tests" description="Run tests">
        <echo message="Running tests with Java 17..."/>
        <junit printsummary="yes"
               haltonfailure="no"
               fork="yes"
               forkmode="once"
               jvm="${java17.home}/bin/java">
            <classpath refid="test.classpath"/>
            <formatter type="plain" usefile="false"/>
            <batchtest>
                <fileset dir="${test.dir}">
                    <include name="**/*Test.java"/>
                </fileset>
            </batchtest>
        </junit>
    </target>

    <target name="clean" description="Clean build artifacts">
        <delete dir="${build.dir}"/>
        <delete dir="${dist.dir}"/>
    </target>

    <target name="clean-all" depends="clean" description="Clean all including downloaded dependencies">
        <delete dir="${lib.dir}"/>
    </target>

    <target name="rebuild" depends="clean,jar" description="Clean and rebuild"/>

    <target name="info" description="Display build information">
        <echo message="Project: ${ant.project.name}"/>
        <echo message="Version: ${version}"/>
        <echo message="Java Source/Target Version: ${java.source.version}"/>
        <echo message="Java Home: ${java17.home}"/>
        <echo message="Source Directory: ${src.dir}"/>
        <echo message="Build Directory: ${build.dir}"/>
        <echo message="Distribution Directory: ${dist.dir}"/>
    </target>

</project>
